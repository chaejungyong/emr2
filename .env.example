PROJECT_NAME=app
WEB_PORT=8081

DB_HOST=db
DB_PORT=3306
DB_NAME=app_db
DB_USER=root
DB_PASSWORD=change-me

FLASK_DEBUG=0

# 인증: 운영에서는 충분히 긴 임의 값과 비밀번호를 반드시 설정하세요.
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME_SECONDS=28800
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# OpenAI 호환 생성 API
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-5.6-terra
LLM_TIMEOUT_SECONDS=90
SOAP_CANDIDATE_COUNT=1

# OpenAI 호환 임베딩 API
EMBEDDING_BASE_URL=https://api.openai.com
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BATCH_SIZE=32

# 검색 및 파일 저장
QDRANT_URL=http://qdrant:6333
QDRANT_ALIAS=kb_active
QDRANT_TIMEOUT_SECONDS=120
QDRANT_UPSERT_BATCH_SIZE=32
RAG_TOP_K=6
STORAGE_ROOT=/app/storage
MAX_REQUEST_BYTES=31457280
MAX_XRAY_BYTES=26214400
MAX_PDF_BYTES=536870912
MAX_PDF_PAGES=10000
WORKER_POLL_SECONDS=3
